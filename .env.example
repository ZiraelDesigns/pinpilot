# Leave unset to use the local SQLite database in the project directory.
DATABASE_URL=sqlite:///./pinpilot.db

# Etsy Open API v3 OAuth 2.0 + PKCE. Use the exact HTTPS callback registered in Etsy.
ETSY_API_KEY=your-etsy-api-key
ETSY_SHARED_SECRET=your-etsy-shared-secret
ETSY_REDIRECT_URI=https://your-domain.example/etsy/callback
# Generate locally: .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ETSY_TOKEN_ENCRYPTION_KEY=

# Pinterest API v5 OAuth 2.0. Register the exact callback URL in the Pinterest developer portal.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=https://your-domain.example/pinterest/callback
# Generate locally: .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PINTEREST_TOKEN_ENCRYPTION_KEY=
# The API adapter accepts only Pinterest's official v5 production/Sandbox hosts.
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5
PINTEREST_API_TIMEOUT_SECONDS=20
# Fail-closed. Keep false until production publishing is separately approved.
PINTEREST_PUBLISH_ENABLED=false

# AI creative generation. "mock" works locally and makes no network calls.
AI_PROVIDER=mock
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public HTTPS origin for generated Pin image URLs, without a trailing slash.
# Leave empty locally. Example: https://pins.your-domain.example
PUBLIC_BASE_URL=
