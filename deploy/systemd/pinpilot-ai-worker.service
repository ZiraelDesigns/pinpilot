[Unit]
Description=PinPilot AI creative generation worker
After=network-online.target pinpilot.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pinpilot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/pinpilot
ExecStart=/opt/pinpilot/.venv/bin/python /opt/pinpilot/scripts/run_ai_worker.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
