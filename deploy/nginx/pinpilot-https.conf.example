# Activate only after a domain or subdomain points to this VPS and a certificate
# has been issued. Replace pins.example.com with the real hostname.

server {
    listen 80;
    server_name pins.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name pins.example.com;

    # Let’s Encrypt paths after certificate issuance.
    ssl_certificate /etc/letsencrypt/live/pins.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pins.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Only generated Pin assets are directly public; no project files, source,
    # database files, or arbitrary /opt/pinpilot paths are exposed.
    location /media/generated/ {
        alias /opt/pinpilot/media/generated/;
        autoindex off;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /media/ {
        return 404;
    }
}
